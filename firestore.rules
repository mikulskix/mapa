rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'mikulskix@gmail.com';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Dostęp do danych mapy ma tylko osoba z zatwierdzonym profilem
    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/profile/main).data.status == 'approved';
    }

    // Profil użytkownika: tożsamość, status zatwierdzenia i koperta z kluczem.
    //
    // NAJWAŻNIEJSZA REGUŁA W CAŁYM PLIKU: właściciel NIE MOŻE sam zmienić
    // swojego pola "status". Gdyby mógł, każda zarejestrowana osoba
    // przyznałaby sobie dostęp do pinezek jednym poleceniem w przeglądarce.
    match /users/{userId}/profile/main {
      allow read: if isOwner(userId) || isAdmin();

      // Zakładając konto można ustawić wyłącznie status "pending"
      allow create: if isAdmin()
        || (isOwner(userId) && request.resource.data.status == 'pending');

      // Właściciel zapisuje tylko kopertę klucza — status musi zostać bez zmian
      allow update: if isAdmin()
        || (isOwner(userId) && request.resource.data.status == resource.data.status);

      allow delete: if isAdmin();
    }

    // Zgłoszenia rejestracyjne (panel admina)
    match /registrations/{docId} {
      // Można utworzyć tylko własne zgłoszenie i tylko jako "pending"
      allow create: if isAdmin()
        || (isOwner(docId) && request.resource.data.status == 'pending');
      allow read, update, delete: if isAdmin();
    }

    // Konfiguracja workspace: sól i weryfikator hasła bazowego.
    //
    // Odczyt ograniczony do osób zatwierdzonych: weryfikator pozwala
    // sprawdzać kolejne hasła poza aplikacją, bez żadnego limitu prób.
    // Wcześniej mógł go pobrać każdy zalogowany, także odrzucony.
    match /workspace/{document=**} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // Pinezki — zaszyfrowane po stronie klienta, tylko dla zatwierdzonych
    match /markers/{id} {
      allow read, write: if isApproved();
    }

    // Kopie zapasowe. Zapis i kasowanie są potrzebne wszystkim zatwierdzonym,
    // bo automatyczna kopia usuwa przy okazji wpisy starsze niż 7 dni.
    match /backups/{id} {
      allow read, write: if isApproved();
    }

    // Kategorie kolorów — zatwierdzone osoby czytają, tylko admin zapisuje
    match /categories/{document=**} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }
  }
}
